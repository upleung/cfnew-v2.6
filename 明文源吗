            scu = getConfigValue('scu', env.scu) || 'https://sublink.iwrt.pp.ua';
            cp = getConfigValue('d', env.d || env.D) || '';

            const url = new URL(request.url);

            if (request.headers.get('Upgrade') === atob('d2Vic29ja2V0')) {
                return await handleWsRequest(request);
            }
            
            if (request.method === 'GET') {
                // 1. 首页直接访问根路径
                if (url.pathname === '/') {
                    return renderTerminalPage(cp);
                }
                
                // 2. 自定义路径模式处理 (支持带或不带开头的斜杠)
                if (cp && cp.trim()) {
                    const cleanCustom = cp.trim().replace(/^\/+|\/+$/g, '');
                    const currentCleanPath = url.pathname.replace(/^\/+|\/+$/g, '');
                    
                    // 访问管理面板：/cfnew-net 或 /cfnew-net/
                    if (currentCleanPath === cleanCustom) {
                        return await handleSubscriptionPage(request, at);
                    }
                    
                    // 访问原生节点订阅：/cfnew-net/sub
                    if (currentCleanPath === cleanCustom + '/sub') {
                        return await handleSubscriptionRequest(request, at, url);
                    }
                } else {
                    // 3. 兼容标准 UUID 路径模式
                    const cleanPath = url.pathname.replace(/^\/+|\/+$/g, '');
                    if (cleanPath === at) {
                        return await handleSubscriptionPage(request, at);
                    }
                    if (cleanPath === at + '/sub') {
                        return await handleSubscriptionRequest(request, at, url);
                    }
                }
            }
            return new Response(JSON.stringify({ error: 'Not Found', path: url.pathname }), { status: 404, headers: { 'Content-Type': 'application/json' }});
        } catch (err) {
            return new Response(err.toString(), { status: 500 });
        }
    },
};

