function isOn(value, defaultValue = false) {
  if (value === undefined || value === null || value === '') return defaultValue;
  if (value === true || value === false) return value;
  return ['yes', 'true', '1', 'on'].includes(String(value).trim().toLowerCase());
}

function text(value, fallback = '') {
  if (value === undefined || value === null) return fallback;
  return String(value);
}

function normalizeBool(value, fallback = false) {
  return isOn(value, fallback) ? 'yes' : 'no';
}

function normalizePath(path) {
  const raw = text(path).trim();
  if (!raw) return '';
  const withSlash = raw.startsWith('/') ? raw : `/${raw}`;
  return withSlash.replace(/\/{2,}/g, '/').replace(/\/$/, '') || '/';
}

function stripPath(pathname) {
  const clean = text(pathname).replace(/\/{2,}/g, '/');
  return clean.endsWith('/') && clean.length > 1 ? clean.slice(0, -1) : clean;
}

function sanitizeNodeName(name) {
  return text(name, 'CF-New').replace(/[\r\n#]/g, '_').trim() || 'CF-New';
}

function toUint8Array(data) {
  if (data instanceof Uint8Array) return data;
  if (data instanceof ArrayBuffer) return new Uint8Array(data);
  if (ArrayBuffer.isView(data)) return new Uint8Array(data.buffer, data.byteOffset, data.byteLength);
  if (typeof data === 'string') return new TextEncoder().encode(data);
  return new Uint8Array(data);
}

function concatBytes(a, b) {
  const left = toUint8Array(a);
  const right = toUint8Array(b);
  const out = new Uint8Array(left.byteLength + right.byteLength);
  out.set(left, 0);
  out.set(right, left.byteLength);
  return out;
}

function uuidToBytes(uuid) {
  const hex = text(uuid).replace(/-/g, '');
  if (hex.length !== 32 || !/^[0-9a-f]+$/i.test(hex)) return null;
  const out = new Uint8Array(16);
  for (let i = 0; i < 16; i++) out[i] = Number.parseInt(hex.slice(i * 2, i * 2 + 2), 16);
  return out;
}

function bytesEqual(a, b) {
  if (!a || !b || a.byteLength !== b.byteLength) return false;
  for (let i = 0; i < a.byteLength; i++) if (a[i] !== b[i]) return false;
  return true;
}

function isValidUuid(uuid) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(text(uuid));
}

function parseAddressAndPort(input, defaultPort = null) {
  const raw = text(input).trim();
  if (!raw) return { address: '', port: defaultPort };
  if (raw.startsWith('[')) {
    const match = raw.match(/^\[([^\]]+)\](?::(\d+))?$/);
    if (match) return { address: match[1], port: match[2] ? Number(match[2]) : defaultPort };
  }
  const lastColon = raw.lastIndexOf(':');
  if (lastColon > 0 && raw.indexOf(':') === lastColon) {
    const candidatePort = Number(raw.slice(lastColon + 1));
    if (candidatePort > 0 && candidatePort <= 65535) return { address: raw.slice(0, lastColon), port: candidatePort };
  }
  return { address: raw, port: defaultPort };
}

function normalizeHostForUri(address) {
  const raw = text(address).trim();
  return raw.includes(':') && !raw.startsWith('[') ? `[${raw}]` : raw;
}

function detectRegion(request, config) {
  if (config.wk) return text(config.wk).trim().toUpperCase();
  const country = request.cf?.country;
  return CF_COUNTRY_REGION[country] || 'SG';
}

function detectNetwork(request, config, requested = '') {
  const forced = text(requested || config.network || '').trim().toLowerCase();
  if (['telecom', 'unicom', 'mobile', 'all'].includes(forced)) return forced;
  if (forced === 'auto' || !forced) {
    const asn = text(request.cf?.asn);
    for (const [network, values] of Object.entries(COMMON_ASN_GROUPS)) {
      if (values.has(asn)) return network;
    }
  }
  return 'all';
}

function getNearbyRegions(region) {
  const map = {
    US: ['CA', 'SG', 'JP', 'HK'], SG: ['HK', 'TW', 'JP', 'AU'], JP: ['KR', 'TW', 'HK', 'SG'],
    HK: ['TW', 'SG', 'JP', 'KR'], TW: ['HK', 'JP', 'SG', 'KR'], KR: ['JP', 'TW', 'HK', 'SG'],
    DE: ['NL', 'SE', 'FI', 'GB', 'FR'], SE: ['FI', 'DE', 'NL', 'GB'], NL: ['DE', 'GB', 'SE', 'FI'],
    FI: ['SE', 'DE', 'NL', 'GB'], GB: ['NL', 'DE', 'FR', 'SE'], AU: ['SG', 'HK', 'JP'], CA: ['US']
  };
  return map[region] || [];
}

function loadDefaults() {
  return {
    wk: '',
    network: 'auto',
    ev: 'yes',
    et: 'no',
    ex: 'no',
    d: '',
    p: '',
    rm: 'yes',
    epd: 'yes',
    epi: 'yes',
    egi: 'yes',
    scu: DEFAULT_SUB_CONVERTER
  };
}

function readEnvConfig(env) {
  const get = (...names) => names.map(n => env?.[n]).find(v => v !== undefined && v !== null && v !== '');
  const cfg = loadDefaults();
  const map = {
    wk: ['wk', 'WK'], network: ['network', 'NETWORK', 'networkType', 'NETWORK_TYPE'],
    ev: ['ev', 'EV'], et: ['et', 'ET'], ex: ['ex', 'EX'], d: ['d', 'D'], p: ['p', 'P'],
    rm: ['rm', 'RM'], epd: ['epd', 'EPD'], epi: ['epi', 'EPI'], egi: ['egi', 'EGI'], scu: ['scu', 'SCU']
  };
  for (const [key, names] of Object.entries(map)) {
    const value = get(...names);
    if (value !== undefined) cfg[key] = text(value);
  }
  return cfg;
}

async function getKVBindings(env) {
  return {
    config: env?.CFNEW_CONFIG || env?.C || null,
    ipPool: env?.CFNEW_IP_POOL || null,
    fallback: env?.CFNEW_FALLBACK || null,
    network: env?.CFNEW_NETWORK_TYPE || null
  };
}

async function readJsonOrText(kv, keys) {
  if (!kv) return null;
  for (const key of keys) {
    try {
      const value = await kv.get(key);
      if (value) {
        try { return JSON.parse(value); } catch { return value; }
      }
    } catch (_) {}
  }
  return null;
}

async function loadConfig(env) {
  const base = readEnvConfig(env);
  const bindings = await getKVBindings(env);
  const stored = await readJsonOrText(bindings.config, ['config', 'c']);
  if (stored && typeof stored === 'object' && !Array.isArray(stored)) Object.assign(base, stored);
  base.d = normalizePath(base.d);
  base.wk = text(base.wk).trim().toUpperCase();
  base.network = text(base.network || 'auto').trim().toLowerCase();
  base.rm = normalizeBool(base.rm, true);
  base.ev = normalizeBool(base.ev, true);
  base.et = normalizeBool(base.et, false);
  base.ex = normalizeBool(base.ex, false);
  base.epd = normalizeBool(base.epd, true);
  base.epi = normalizeBool(base.epi, true);
  base.egi = normalizeBool(base.egi, true);
  base.scu = text(base.scu, DEFAULT_SUB_CONVERTER);
  if (base.ev === 'no' && base.et === 'no' && base.ex === 'no') base.ev = 'yes';
  return { config: base, bindings };
}

async function saveUiConfig(env, patch) {
  const bindings = await getKVBindings(env);
  if (!bindings.config) throw new Error('CFNEW_CONFIG / C KV binding is not configured');
  const existing = await readJsonOrText(bindings.config, ['config', 'c']);
  const current = existing && typeof existing === 'object' && !Array.isArray(existing) ? existing : {};
  const next = { ...current };
  if (patch.wk !== undefined) next.wk = text(patch.wk).trim().toUpperCase();
  if (patch.network !== undefined) next.network = text(patch.network).trim().toLowerCase();
  await bindings.config.put('config', JSON.stringify(next));
  // 保留旧版 C/c 的兼容读取：新配置不需要同时写两份。
  return next;
}

function parsePoolText(value) {
  if (!value) return [];
  if (Array.isArray(value)) return value;
  if (typeof value === 'object') return value.list || value.ips || [];
  return String(value).split(/\r?\n|,/).map(line => line.trim()).filter(Boolean).map(line => {
    const [first, ...nameParts] = line.split('#');
    const parsed = parseAddressAndPort(first, 443);
    return {
      ip: parsed.address,
      port: parsed.port || 443,
      name: nameParts.join('#').trim() || parsed.address,
      region: ''
    };
  });
}

async function loadIpPool(env, network) {
  const bindings = await getKVBindings(env);
  const stored = await readJsonOrText(bindings.ipPool, ['list', 'ips', 'ip_pool']);
  const parsed = parsePoolText(stored);
  if (parsed.length) return parsed.map((item, i) => ({
    ip: text(item.ip || item.domain || item.address),
    port: Number(item.port) > 0 ? Number(item.port) : 443,
    name: sanitizeNodeName(item.name || item.isp || `优选-${i + 1}`),
    region: text(item.region || item.regionCode || 'US').toUpperCase(),
    network: text(item.network || '').toLowerCase()
  })).filter(item => item.ip);

  const ordered = network === 'telecom' ? TRI_NET_IPS.telecom : network === 'unicom' ? TRI_NET_IPS.unicom : network === 'mobile' ? TRI_NET_IPS.mobile : [
    ...TRI_NET_IPS.telecom, ...TRI_NET_IPS.unicom, ...TRI_NET_IPS.mobile
  ];
  return ordered.map(item => ({ ip: item.ip, port: 443, name: item.name, region: item.region, network: '' }));
}

async function loadFallbacks(env) {
  const bindings = await getKVBindings(env);
  const stored = await readJsonOrText(bindings.fallback, ['list', 'fallback', 'ips']);
  const parsed = parsePoolText(stored);
  if (!parsed.length) return DEFAULT_FALLBACKS;
  return parsed.map(item => ({
    domain: text(item.domain || item.ip || item.address),
    regionCode: text(item.regionCode || item.region || '').toUpperCase(),
    port: Number(item.port) > 0 ? Number(item.port) : 443
  })).filter(item => item.domain);
}

function orderFallbacks(fallbacks, region, regionMatch = true, manualFallback = '') {
  const result = [];
  const add = (domain, port) => {
    const key = `${domain}:${port}`;
    if (!result.some(x => `${x.domain}:${x.port}` === key)) result.push({ domain, port });
  };
  if (manualFallback) {
    const parsed = parseAddressAndPort(manualFallback, 443);
    if (parsed.address) add(parsed.address, parsed.port || 443);
  }
  // 需求文档指定的全局 fallback 兜底第一优先级。
  for (const host of CF_FALLBACK_IPS) add(host, 443);

  const list = Array.isArray(fallbacks) ? fallbacks : [];
  if (regionMatch && region) {
    for (const r of [region, ...getNearbyRegions(region)]) {
      for (const item of list.filter(v => v.regionCode === r)) add(item.domain, item.port || 443);
    }
  }
  for (const item of list) add(item.domain, item.port || 443);
  return result.slice(0, 6);
}

function makeWsPath(basePath, network = 'all', extra = {}) {
  const path = basePath || '/';
  const params = new URLSearchParams({ [WS_PATH_QUERY.split('=')[0]]: WS_PATH_QUERY.split('=')[1] });
  if (network && network !== 'all') params.set('nt', network);
  if (extra.rm === false) params.set('rm', 'no');
  if (extra.p) params.set('p', extra.p);
  return `${path}?${params.toString()}`;
}

function makeVlessLink({ server, port, tls, uuid, workerDomain, wsPath, name }) {
  const safeAddress = normalizeHostForUri(server);
  const params = new URLSearchParams({
    encryption: 'none',
    security: tls ? 'tls' : 'none',
    type: 'ws',
    host: workerDomain,
    path: wsPath
  });
  if (tls) {
    params.set('sni', workerDomain);
    params.set('fp', 'chrome');
  }
  return `vless://${uuid}@${safeAddress}:${port}?${params.toString()}#${encodeURIComponent(sanitizeNodeName(name))}`;
}

async function generateSubscription(request, env, uuid, url, cfg) {
  const workerDomain = url.hostname;
  const basePath = cfg.d || `/${uuid}`;
  const network = detectNetwork(request, cfg, url.searchParams.get('network') || url.searchParams.get('nt') || cfg.network);
  const region = detectRegion(request, cfg);
  const regionMatch = cfg.rm !== 'no';
  const links = [];
  const wsPath = makeWsPath(basePath, network, { rm: !regionMatch, p: cfg.p });

  if (isOn(cfg.epd, true)) {
    for (const item of DIRECT_DOMAINS) {
      links.push(makeVlessLink({ server: item.domain, port: 443, tls: true, uuid, workerDomain, wsPath, name: `${item.name}-443-TLS` }));
      links.push(makeVlessLink({ server: item.domain, port: 80, tls: false, uuid, workerDomain, wsPath, name: `${item.name}-80-WS` }));
    }
  }

  if (isOn(cfg.epi, true)) {
    const pool = await loadIpPool(env, network);
    for (const item of pool) {
      const suffix = item.network ? `-${item.network}` : '';
      links.push(makeVlessLink({ server: item.ip, port: 443, tls: true, uuid, workerDomain, wsPath, name: `${item.name}${suffix}-443-TLS` }));
      links.push(makeVlessLink({ server: item.ip, port: 80, tls: false, uuid, workerDomain, wsPath, name: `${item.name}${suffix}-80-WS` }));
    }
  }

  // 始终生成一个使用 Worker 域名的“原生入口”，用于验证 DNS/路由本身是否正常。
  links.push(makeVlessLink({ server: workerDomain, port: 443, tls: true, uuid, workerDomain, wsPath, name: 'CF原生入口-443-TLS' }));
  links.push(makeVlessLink({ server: workerDomain, port: 80, tls: false, uuid, workerDomain, wsPath, name: 'CF原生入口-80-WS' }));

  if (!links.length) {
    links.push(`vless://${uuid}@127.0.0.1:80?encryption=none&security=none&type=ws&host=error.com&path=%2F#CF-New-error`);
  }

  return { links, network, region, nodeCount: links.length, wsPath };
}

function buildSubscriptionResponse(links) {
  const body = btoa(unescape(encodeURIComponent(links.join('\n'))));
  return new Response(body, {
    status: 200,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'Cache-Control': 'no-store, no-cache, must-revalidate, max-age=0',
      'Access-Control-Allow-Origin': '*',
      'X-CFNew-Version': VERSION,
      'X-CFNew-Node-Count': String(links.length)
    }
  });
}

function createUploadQueue(maxBytes = MAX_UPLOAD_QUEUE) {
  let chunks = [];
  let bytes = 0;
  let draining = false;
  let drainResolver = null;
  const notify = () => { if (drainResolver) { const r = drainResolver; drainResolver = null; r(); } };
  return {
    get empty() { return chunks.length === 0; },
    get bytes() { return bytes; },
    clear() { chunks = []; bytes = 0; notify(); },
    push(data) {
      const chunk = toUint8Array(data);
      if (!chunk.byteLength) return true;
      if (bytes + chunk.byteLength > maxBytes) return false;
      chunks.push(chunk.slice()); bytes += chunk.byteLength; return true;
    },
    async drain(getWriter) {
      if (draining) return;
      draining = true;
      try {
        while (chunks.length) {
          const writer = getWriter();
          if (!writer) break;
          const chunk = chunks.shift();
          bytes -= chunk.byteLength;
          try {
            await writer.write(chunk);
          } catch {
            chunks.unshift(chunk); bytes += chunk.byteLength;
            break;
          }
        }
      } finally {
        draining = false;
        notify();
      }
    },
    async waitForDrain() {
      if (!chunks.length) return;
      await new Promise(resolve => { drainResolver = resolve; });
    }
  };
}

async function openSocket(host, port) {
  const socket = connect({ hostname: host, port });
  if (socket?.opened) await socket.opened;
  return socket;
}

function closeSocket(socket) {
  try { socket?.close(); } catch (_) {}
}

function closeWs(ws) {
  try { if (ws?.readyState === 1 || ws?.readyState === 0) ws.close(); } catch (_) {}
}

async function pipeRemoteToWs(socket, ws, responseHeader, timeoutMs) {
  let reader = null;
  let firstByte = false;
  let timedOut = false;
  let done = false;
  const timer = setTimeout(() => {
    if (!firstByte && !done) {
      timedOut = true;
      closeSocket(socket);
    }
  }, timeoutMs);

  try {
    reader = socket.readable.getReader();
    for (;;) {
      const { value, done: readDone } = await reader.read();
      if (readDone) break;
      const chunk = toUint8Array(value);
      if (!chunk.byteLength) continue;
      firstByte = true;
      if (ws.readyState !== 1) throw new Error('websocket closed');
      const payload = responseHeader ? concatBytes(responseHeader, chunk) : chunk;
      responseHeader = null;
      ws.send(payload);
    }
  } catch (_) {
    // 交由上层判断是否允许 fallback。
  } finally {
    done = true;
    clearTimeout(timer);
    try { reader?.releaseLock(); } catch (_) {}
  }
  return { firstByte, timedOut };
}

function parseVlessHeader(buffer, uuid) {
  const data = toUint8Array(buffer);
  if (data.byteLength < 17) return { needMore: true };
  const expected = uuidToBytes(uuid);
  if (!expected) return { error: 'invalid UUID configuration' };
  if (!bytesEqual(data.subarray(1, 17), expected)) return { error: 'invalid user' };

  const optLen = data[17];
  const commandIndex = 18 + optLen;
  if (data.byteLength < commandIndex + 4) return { needMore: true };
  const command = data[commandIndex];
  if (command !== 1 && command !== 2) return { error: 'command is not supported' };

  const portIndex = commandIndex + 1;
  const port = (data[portIndex] << 8) | data[portIndex + 1];
  const addressIndex = portIndex + 2;
  if (data.byteLength < addressIndex + 1) return { needMore: true };
  const addressType = data[addressIndex];
  let cursor = addressIndex + 1;
  let hostname = '';

  if (addressType === 1) {
    if (data.byteLength < cursor + 4) return { needMore: true };
    hostname = `${data[cursor]}.${data[cursor + 1]}.${data[cursor + 2]}.${data[cursor + 3]}`;
    cursor += 4;
  } else if (addressType === 2) {
    if (data.byteLength < cursor + 1) return { needMore: true };
    const length = data[cursor++];
    if (data.byteLength < cursor + length) return { needMore: true };
    hostname = new TextDecoder().decode(data.subarray(cursor, cursor + length));
    cursor += length;
  } else if (addressType === 3) {
    if (data.byteLength < cursor + 16) return { needMore: true };
    const view = new DataView(data.buffer, data.byteOffset + cursor, 16);
    const parts = [];
    for (let i = 0; i < 8; i++) parts.push(view.getUint16(i * 2).toString(16));
    hostname = parts.join(':');
    cursor += 16;
  } else {
    return { error: `invalid addressType: ${addressType}` };
  }

  if (!hostname) return { error: 'addressValue is empty' };
  return {
    version: data[0],
    command,
    isUDP: command === 2,
    addressType,
    hostname,
    port,
    rawIndex: cursor,
    remaining: data.subarray(cursor)
  };
}

function isAllowedWsPath(requestPath, basePath) {
  return stripPath(requestPath) === stripPath(basePath || '/');
}

function getPathBase(cfg, uuid) {
  return cfg.d || `/${uuid}`;
}

async function handleWebSocket(request, env, ctx, uuid, cfg) {
  const url = new URL(request.url);
  const basePath = getPathBase(cfg, uuid);
  if (!isAllowedWsPath(url.pathname, basePath)) {
    return new Response('WebSocket path not allowed', { status: 404 });
  }

  const pair = new WebSocketPair();
  const [client, server] = Object.values(pair);
  server.accept();
  server.binaryType = 'arraybuffer';

  const state = {
    closed: false,
    parsed: false,
    firstBuffer: new Uint8Array(0),
    remote: null,
    writer: null,
    initialPayload: null,
    responseHeader: null,
    retrying: false,
    retryIndex: -1,
    pipePromise: null,
    uploadQueue: createUploadQueue()
  };

  const closeAll = () => {
    if (state.closed) return;
    state.closed = true;
    state.uploadQueue.clear();
    try { state.writer?.releaseLock(); } catch (_) {}
    state.writer = null;
    closeSocket(state.remote);
    state.remote = null;
    closeWs(server);
  };

  const queryP = url.searchParams.get('p') || '';
  const queryRegion = text(url.searchParams.get('wk') || cfg.wk).trim().toUpperCase();
  const queryRm = (url.searchParams.get('rm') || '').trim().toLowerCase() !== 'no';
  const queryNetwork = text(url.searchParams.get('nt') || cfg.network || 'auto').trim().toLowerCase();
  const actualRegion = queryRegion || detectRegion(request, cfg);
  const actualNetwork = detectNetwork(request, cfg, queryNetwork);
  const fallbacks = await loadFallbacks(env);
  const candidates = orderFallbacks(fallbacks, actualRegion, queryRm, queryP);

  function getWriter() { return state.writer; }

  async function drainUpload() {
    if (state.closed || !state.writer) return;
    await state.uploadQueue.drain(getWriter);
  }

  async function setRemote(socket, writer) {
    try { state.writer?.releaseLock(); } catch (_) {}
    state.remote = socket;
    state.writer = writer;
    await drainUpload();
  }

  async function connectCandidate(host, port, resendInitial = true) {
    const socket = await openSocket(host, port);
    const writer = socket.writable.getWriter();
    if (resendInitial && state.initialPayload?.byteLength) {
      await writer.write(state.initialPayload);
    }
    await setRemote(socket, writer);
    return socket;
  }

  async function attachPipe(socket, responseHeader, allowRetry) {
    const result = await pipeRemoteToWs(socket, server, responseHeader, FIRST_BYTE_TIMEOUT_MS);
    if (state.closed || state.remote !== socket) return;
    if (!result.firstByte && allowRetry && !state.retrying) {
      state.retrying = true;
      closeSocket(socket);
      try { state.writer?.releaseLock(); } catch (_) {}
      state.writer = null;
      state.remote = null;
      await startFallbacks();
    } else if (!result.firstByte) {
      closeAll();
    } else {
      // 首字节已经到达，后续连接结束时正常关闭 WS，不再把已建立连接误判为 fallback。
      closeAll();
    }
  }

  async function tryAttach(host, port, allowRetry) {
    try {
      const socket = await connectCandidate(host, port, true);
      state.pipePromise = attachPipe(socket, state.responseHeader, allowRetry).catch(() => closeAll());
      return true;
    } catch (_) {
      return false;
    }
  }

  async function startFallbacks() {
    if (state.closed) return;
    for (let i = state.retryIndex + 1; i < candidates.length; i++) {
      state.retryIndex = i;
      const candidate = candidates[i];
      const ok = await tryAttach(candidate.domain, candidate.port, i < candidates.length - 1);
      if (ok) {
        state.retrying = false;
        return;
      }
    }
    state.retrying = false;
    closeAll();
  }

  async function establish(host, port, initialPayload, responseHeader) {
    state.initialPayload = initialPayload;
    state.responseHeader = responseHeader;
    state.retryIndex = -1;
    const directOk = await tryAttach(host, port, true);
    if (!directOk) await startFallbacks();
  }

  const onMessage = event => {
    // 串行化所有客户端 message，避免多个 async handler 同时写同一个 Stream writer。
    messageChain = messageChain.then(async () => {
      if (state.closed) return;
      const chunk = toUint8Array(event.data);
      if (!chunk.byteLength) return;

      if (!state.parsed) {
        state.firstBuffer = concatBytes(state.firstBuffer, chunk);
        if (state.firstBuffer.byteLength > MAX_INITIAL_BUFFER) throw new Error('initial buffer too large');
        const result = parseVlessHeader(state.firstBuffer, uuid);
        if (result.needMore) return;
        if (result.error) throw new Error(result.error);
        if (result.isUDP) throw new Error('UDP is not supported by TCP sockets runtime; use TCP-based DNS/HTTP3 fallback off');
        state.parsed = true;
        const initialPayload = result.remaining;
        state.firstBuffer = new Uint8Array(0);
        const responseHeader = new Uint8Array([result.version, 0]);
        await establish(result.hostname, result.port, initialPayload, responseHeader);
        return;
      }

      if (!state.uploadQueue.push(chunk)) throw new Error('upload queue overflow');
      await drainUpload();
    }).catch(() => closeAll());
  };

  let messageChain = Promise.resolve();
  server.addEventListener('message', onMessage);
  server.addEventListener('close', closeAll);
  server.addEventListener('error', closeAll);

  // 发送 101 后，真正的连接工作由事件回调继续运行。
  ctx?.waitUntil?.(messageChain.catch(() => {}));
  return new Response(null, { status: 101, webSocket: client });
}

function base64Utf8(textValue) {
  const bytes = new TextEncoder().encode(textValue);
  let binary = '';
  const step = 0x8000;
  for (let i = 0; i < bytes.length; i += step) binary += String.fromCharCode(...bytes.subarray(i, i + step));
  return btoa(binary);
}

function htmlEscape(value) {
  return text(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

