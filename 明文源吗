export default {
  async fetch(request, env, ctx) {
    try {
      const url = new URL(request.url);
      const { config: cfg } = await loadConfig(env);
      const uuid = text(env?.u || env?.U || DEFAULT_UUID).toLowerCase();
      if (!isValidUuid(uuid)) return new Response(JSON.stringify({ error: 'Invalid UUID configuration' }), { status: 500, headers: { 'Content-Type': 'application/json' } });
      const basePath = getPathBase(cfg, uuid);
      const pathname = stripPath(url.pathname);

      // WebSocket 必须先经过路径校验，修复原版“任何 WS 路径都直接进代理”的 path mapping 问题。
      if (request.headers.get('Upgrade')?.toLowerCase() === 'websocket') {
        return await handleWebSocket(request, env, ctx, uuid, cfg);
      }

      if (request.method === 'OPTIONS') {
        return new Response(null, { status: 204, headers: { 'Access-Control-Allow-Origin': '*', 'Access-Control-Allow-Methods': 'GET,POST,OPTIONS', 'Access-Control-Allow-Headers': 'Content-Type,Authorization' } });
      }

      if (request.method === 'GET' && pathname === '/') return renderTerminalPage(cfg);

      if (request.method === 'GET' && pathname === basePath) {
        return await renderSubscriptionPage(request, env, uuid, cfg, basePath);
      }

      if (request.method === 'GET' && pathname === `${basePath}/sub`) {
        const result = await generateSubscription(request, env, uuid, url, cfg);
        return buildSubscriptionResponse(result.links);
      }

      if (pathname === `${basePath}/api/status`) {
        const result = await generateSubscription(request, env, uuid, url, cfg);
        const net = detectNetwork(request, cfg, url.searchParams.get('network') || url.searchParams.get('nt') || cfg.network);
        return renderStatus({ ok: true, version: VERSION, path: basePath, nodeCount: result.nodeCount, region: result.region, network: net, networkLabel: NETWORK_LABELS[net] || NETWORK_LABELS.all, websocketPath: result.wsPath, kv: Boolean((await getKVBindings(env)).config) });
      }

      if (pathname === `${basePath}/api/config` && request.method === 'GET') {
        const { config } = await loadConfig(env);
        return renderStatus({ wk: config.wk, network: config.network, d: config.d, scu: config.scu });
      }

      if (pathname === `${basePath}/api/config` && request.method === 'POST') {
        let body = null;
        try { body = await request.json(); } catch { body = {}; }
        const saved = await saveUiConfig(env, body || {});
        return renderStatus({ ok: true, config: saved });
      }

      if (pathname === '/healthz') return new Response('ok', { status: 200, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' } });

      return new Response(JSON.stringify({ error: 'Not Found', path: url.pathname }), { status: 404, headers: { 'Content-Type': 'application/json;charset=utf-8' } });
    } catch (error) {
      return new Response(JSON.stringify({ error: text(error?.message || error, 'Internal Error'), version: VERSION }), { status: 500, headers: { 'Content-Type': 'application/json;charset=utf-8', 'Cache-Control': 'no-store' } });
    }
  }
};
