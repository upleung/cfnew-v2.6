async function handleSubscriptionRequest(request, user, url = null) {
    if (!url) url = new URL(request.url);
    const finalLinks = [];
    const workerDomain = url.hostname;

    // 1. 挂载 4 个实测高速反代域名 (visa, icook, visa.sg, cf.090227)
    directDomains.forEach(item => {
        finalLinks.push(...generateDualPortNodes(item.domain, item.name, user, workerDomain));
    });

    // 2. 挂载三网高速优选 Anycast 节点 (电信 / 联通 / 移动)
    triNetIPs.forEach(item => {
        finalLinks.push(...generateDualPortNodes(item.ip, item.isp, user, workerDomain));
    });

    // 3. 挂载原生节点
    finalLinks.push(...generateDualPortNodes(workerDomain, 'CF原生节点', user, workerDomain));

    const subscriptionContent = btoa(finalLinks.join('\n'));
    return new Response(subscriptionContent, { 
        headers: { 
            'Content-Type': 'text/plain; charset=utf-8', 
            'Cache-Control': 'no-store, no-cache, must-revalidate',
            'Access-Control-Allow-Origin': '*'
        }
    });
}

// 辅助函数：同时生成 443-TLS 与 80-非TLS 节点
function generateDualPortNodes(address, name, user, workerDomain) {
    const links = [];
    const proto = atob('dmxlc3M='); // vless
    const wsPath = '/?ed=2048';
    const cleanAddr = address.includes(':') ? `[${address}]` : address;

    // 443 端口 (TLS)
    const tlsParams = new URLSearchParams({
        encryption: 'none',
        security: 'tls',
        sni: workerDomain,
        fp: 'chrome',
        type: 'ws',
        host: workerDomain,
        path: wsPath
    });
    links.push(`${proto}://${user}@${cleanAddr}:443?${tlsParams.toString()}#${encodeURIComponent(name + '-443-TLS')}`);

    // 80 端口 (Non-TLS)
    const nonTlsParams = new URLSearchParams({
        encryption: 'none',
        security: 'none',
        type: 'ws',
        host: workerDomain,
        path: wsPath
    });
    links.push(`${proto}://${user}@${cleanAddr}:80?${nonTlsParams.toString()}#${encodeURIComponent(name + '-80-WS')}`);

    return links;
}

// [修复点 7] 核心 WebSocket 转发与备用节点回落（彻底解决 -1 ms 连接无响应）
async function handleWsRequest(request) {
    const wsPair = new WebSocketPair();
    const [clientSock, serverSock] = Object.values(wsPair);
    serverSock.accept();
    let remoteConnWrapper = { socket: null };

    const readable = new ReadableStream({
        start(controller) {
            serverSock.addEventListener('message', (event) => controller.enqueue(event.data));
            serverSock.addEventListener('close', () => controller.close());
            serverSock.addEventListener('error', (err) => controller.error(err));
        }
    });

    readable.pipeTo(new WritableStream({
        async write(chunk) {
            if (remoteConnWrapper.socket) {
                const writer = remoteConnWrapper.socket.writable.getWriter();
                await writer.write(chunk); 
                writer.releaseLock(); 
                return;
            }
            if (chunk.byteLength >= 24) {
                const vlessResult = parseWsPacketHeader(chunk, at);
                if (!vlessResult.hasError) {
                    await forwardTCP(vlessResult.addressType, vlessResult.hostname, vlessResult.port, chunk.slice(vlessResult.rawIndex), serverSock, new Uint8Array([vlessResult.version[0], 0]), remoteConnWrapper);
                }
            }
        },
    })).catch(() => {});
    return new Response(null, { status: 101, webSocket: clientSock });
}

// [修复点 8] 支持直连与 ProxyIP 智能回退，确保节点连通
async function forwardTCP(addrType, host, portNum, rawData, ws, respHeader, remoteConnWrapper) {
    async function connectAndSend(address, port) {
        const remoteSock = connect({ hostname: address, port: port });
        const writer = remoteSock.writable.getWriter();
        await writer.write(rawData); 
        writer.releaseLock();
        return remoteSock;
    }

    async function retryFallback() {
        try {
            // 直连失败时使用动态优选备用出口
            const bestBackup = await getBestBackupIP(currentWorkerRegion);
            const fallbackHost = fallbackAddress || (bestBackup ? bestBackup.domain : 'ProxyIP.SG.CMLiussss.net');
            const fallbackPortNum = parseInt(fallbackPort, 10) || 443;
            const fbSocket = await connectAndSend(fallbackHost, fallbackPortNum);
            remoteConnWrapper.socket = fbSocket;
            pipeRemoteToWs(fbSocket, ws, respHeader);
        } catch (e) {
            try { ws.close(); } catch (_) {}
        }
    }

    try {
        const initialSocket = await connectAndSend(host, portNum);
        remoteConnWrapper.socket = initialSocket;
        pipeRemoteToWs(initialSocket, ws, respHeader, retryFallback);
    } catch (err) {
        await retryFallback();
    }
}

function pipeRemoteToWs(remoteSocket, ws, respHeader, onRetry) {
    let header = respHeader;
    let hasData = false;
    remoteSocket.readable.pipeTo(new WritableStream({
        async write(chunk) {
            hasData = true;
            if (ws.readyState === 1) {
                if (header) { 
                    ws.send(await new Blob([header, chunk]).arrayBuffer()); 
                    header = null; 
                } else { 
                    ws.send(chunk); 
                }
            }
        }
    })).catch(() => { try { ws.close(); } catch (_) {} });
    if (!hasData && onRetry) onRetry();
}

function parseWsPacketHeader(chunk, token) {
    if (chunk.byteLength < 24) return { hasError: true };
    const version = new Uint8Array(chunk.slice(0, 1));
    const hexTable = Array.from({ length: 256 }, (v, i) => (i + 256).toString(16).slice(1));
    const arr = new Uint8Array(chunk.slice(1, 17));
    const id = (hexTable[arr[0]]+hexTable[arr[1]]+hexTable[arr[2]]+hexTable[arr[3]]+"-"+hexTable[arr[4]]+hexTable[arr[5]]+"-"+hexTable[arr[6]]+hexTable[arr[7]]+"-"+hexTable[arr[8]]+hexTable[arr[9]]+"-"+hexTable[arr[10]]+hexTable[arr[11]]+hexTable[arr[12]]+hexTable[arr[13]]+hexTable[arr[14]]+hexTable[arr[15]]).toLowerCase();
    if (id !== token) return { hasError: true };
    
    const optLen = new Uint8Array(chunk.slice(17, 18))[0];
    const portIdx = 19 + optLen;
    const port = new DataView(chunk.slice(portIdx, portIdx + 2)).getUint16(0);
    let addrIdx = portIdx + 2, addrLen = 0, addrValIdx = addrIdx + 1, hostname = '';
    const addressType = new Uint8Array(chunk.slice(addrIdx, addrValIdx))[0];
    switch (addressType) {
        case 1: addrLen = 4; hostname = new Uint8Array(chunk.slice(addrValIdx, addrValIdx + addrLen)).join('.'); break;
        case 2: addrLen = new Uint8Array(chunk.slice(addrValIdx, addrValIdx + 1))[0]; addrValIdx += 1; hostname = new TextDecoder().decode(chunk.slice(addrValIdx, addrValIdx + addrLen)); break;
        case 3: addrLen = 16; const ipv6 = []; const ipv6View = new DataView(chunk.slice(addrValIdx, addrValIdx + addrLen)); for (let i = 0; i < 8; i++) ipv6.push(ipv6View.getUint16(i * 2).toString(16)); hostname = ipv6.join(':'); break;
    }
    return { hasError: false, addressType, port, hostname, rawIndex: addrValIdx + addrLen, version };
}

