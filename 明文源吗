                    <button class="btn" onclick="applyClient('quanx', 'QUANTUMULT X')">QUANTUMULT X</button>
                </div>
                <div class="sub-box" id="subUrlDisplay">点击上方按钮生成并复制订阅直链...</div>
            </div>
        </div>
        <script>
            // [核心修复] 清洗 URL，防止 # 参数污染转换后端
            var baseUrl = window.location.origin + window.location.pathname.replace(/\\/+$/, "").replace(/\\/sub$/, "");
            var nativeSubUrl = baseUrl + "/sub";
            var subConverter = "${scu}";

            function applyClient(clientType, clientName) {
                var finalUrl = nativeSubUrl;
                if (clientType !== 'v2ray') {
                    // 调用指定的订阅后端，并处理 encode 避免 clash 解析失败
                    finalUrl = subConverter + "?target=" + clientType + "&url=" + encodeURIComponent(nativeSubUrl);
                }
                
                var displayBox = document.getElementById("subUrlDisplay");
                displayBox.textContent = finalUrl;
                
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(finalUrl).then(function() {
                        alert("✅ [" + clientName + "] " + "${翻译值.subscriptionCopied}");
                    });
                } else {
                    // Fallback
                    var textArea = document.createElement("textarea");
                    textArea.value = finalUrl;
                    document.body.appendChild(textArea);
                    textArea.select();
                    document.execCommand("copy");
                    textArea.remove();
                    alert("✅ [" + clientName + "] " + "${翻译值.subscriptionCopied}");
                }
            }
        </script>
    </body>
    </html>`;
  return new Response(值页面, { status: 200, headers: { 'Content-Type': 'text/html; charset=utf-8' } });
}

// [修复] 处理订阅下发列表
async function 处理订阅请求(请求507, 用户506, 网址505 = null) {
  if (!网址505) 网址505 = new URL(请求507.url);
