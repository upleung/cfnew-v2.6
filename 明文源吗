function generateLinksFromSource(list, user, workerDomain) {
    const CF_HTTP_PORTS = [80, 8080, 8880, 2052, 2082, 2086, 2095];
    const CF_HTTPS_PORTS = [443, 2053, 2083, 2087, 2096, 8443];
    const links = [];
    const proto = atob('dmxlc3M=');
    list.forEach(item => {
        let nodeNameBase = item.isp.replace(/\s/g, '_');
        if (item.colo && item.colo.trim()) nodeNameBase = `${nodeNameBase}-${item.colo.trim()}`;
        const safeIP = item.ip.includes(':') ? `[${item.ip}]` : item.ip;
        let portsToGenerate = item.port ? [{ port: item.port, tls: CF_HTTPS_PORTS.includes(item.port) }] : [{port: 443, tls: true}];
        
        portsToGenerate.forEach(({ port, tls }) => {
            const params = new URLSearchParams({ encryption: 'none', security: tls ? 'tls' : 'none', sni: tls ? workerDomain : '', type: 'ws', host: workerDomain, path: '/?ed=2048' });
            links.push(`${proto}://${user}@${safeIP}:${port}?${params.toString()}#${encodeURIComponent(nodeNameBase + (tls ? '-TLS' : ''))}`);
        });
    });
    return links;
}

async function generateTrojanLinksFromSource(list, user, workerDomain) {
