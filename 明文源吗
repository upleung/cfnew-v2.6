async function 处理订阅请求(请求507, 用户506, 网址505 = null) {
  if (!网址505) 网址505 = new URL(请求507.url);
  const 最终链接列表 = [];
  const 工作器域名504 = 网址505.hostname;
  const 目标503 = 网址505.searchParams.get('target') || 'base64';
  const 别名命名器 = 创建值节点命名器(false);

  // 【强力修复】保证 443(TLS) 与 80(非TLS) 双端口同时下发
  function 生成节点池(列表, 附加名字) {
    const 协议 = atob('dmxlc3M=');
    const 网页套接字路径 = '/?ed=2048';
    for (const 项 of 列表) {
      const 安全地址 = 项.ip.includes(':') ? `[${项.ip}]` : 项.ip;
      const 基础名 = 项.isp || 附加名字;
      
      // 生成 443 TLS 节点
      const tlsParams = new URLSearchParams({
        encryption: 'none', security: 'tls', sni: 工作器域名504, fp: 'chrome',
        type: 'ws', host: 工作器域名504, path: 网页套接字路径
      });
      最终链接列表.push(`${协议}://${用户506}@${安全地址}:443?${tlsParams.toString()}#${encodeURIComponent(基础名+'-443-TLS')}`);
      
      // 生成 80 非TLS 节点
      if (!禁用非传输层安全) {
        const nonTlsParams = new URLSearchParams({
          encryption: 'none', security: 'none', type: 'ws', host: 工作器域名504, path: 网页套接字路径
        });
        最终链接列表.push(`${协议}://${用户506}@${安全地址}:80?${nonTlsParams.toString()}#${encodeURIComponent(基础名+'-80-WS')}`);
      }
    }
  }

  // 1. 直连优质域名注入 (4个指定域名)
  生成节点池(直连域名列表.map(d => ({ ip: d.domain, isp: d.name })), '直连域名');
  
  // 2. 三网自动优选 IP 注入 (解决原生连通性 -1 的核心)
  生成节点池(三网优选IP, '优选IP');

  // 3. 原生节点兜底
  最终链接列表.push(...生成链接列表来源源([{ ip: 工作器域名504, isp: 'CF原生节点-兜底' }], 用户506, 工作器域名504));

  // 4. YAML / JSON 结构化转换引擎
  let 订阅内容;
  let 内容类型483 = 'text/plain; charset=utf-8';
  switch (目标503.toLowerCase()) {
    case atob('Y2xhc2g='):
    case 'meta':
      订阅内容 = 生成ClashYAML(最终链接列表);
      内容类型483 = 'text/yaml; charset=utf-8';
      break;
    case atob('c2luZ2JveA=='):
      订阅内容 = 生成SingBoxJSON(最终链接列表);
      内容类型483 = 'application/json; charset=utf-8';
      break;
    default:
      订阅内容 = btoa(最终链接列表.join('\n'));
  }

  return new Response(订阅内容, {
    headers: {
      'Content-Type': 内容类型483,
      'Cache-Control': 'no-store, no-cache, must-revalidate'
    }
  });
}

function 生成链接列表来源源(列表, 用户, 工作器域名) {
  const 链接列表 = [];
  const 协议 = atob('dmxlc3M=');
  for (const 项 of 列表) {
    const 安全地址 = 项.ip.includes(':') ? `[${项.ip}]` : 项.ip;
    const 参数 = new URLSearchParams({ encryption: 'none', security: 'tls', sni: 工作器域名, fp: 'chrome', type: 'ws', host: 工作器域名, path: '/?ed=2048' });
    链接列表.push(`${协议}://${用户}@${安全地址}:443?${参数.toString()}#${encodeURIComponent(项.isp)}`);
  }
  return 链接列表;
}

// [修复] 将远端规则拉取的 CDN 替换为官方高可用 cdn.jsdelivr.net
function 生成ClashYAML(链接列表) {
  const 节点列表 = 链接列表.map(解析值链接).filter(n => n && n.proto === 'vless');
  const 节点名列表 = 节点列表.map(n => n.name);
  const 规则提供基础 = 'https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release';
  
  const rules = `
rule-providers:
  reject:
    type: http
    behavior: domain
    url: "${规则提供基础}/reject.txt"
    path: ./rulesets/reject.txt
    interval: 86400
  direct:
    type: http
    behavior: domain
    url: "${规则提供基础}/direct.txt"
    path: ./rulesets/direct.txt
    interval: 86400
  proxy:
    type: http
    behavior: domain
    url: "${规则提供基础}/proxy.txt"
    path: ./rulesets/proxy.txt
    interval: 86400
rules:
  - RULE-SET,reject,REJECT
  - RULE-SET,direct,DIRECT
  - RULE-SET,proxy,🚀 节点选择
  - MATCH,🐟 漏网之鱼`;

  const 代理组 = `
proxy-groups:
  - name: "🚀 节点选择"
    type: select
    proxies:
      - "🎯 全球直连"
${节点名列表.map(n => `      - "${n}"`).join('\n')}
  - name: "🎯 全球直连"
    type: select
    proxies:
      - DIRECT
  - name: "🐟 漏网之鱼"
    type: select
    proxies:
      - "🚀 节点选择"
      - DIRECT`;

  const 代理 = `proxies:\n${节点列表.map(n => {
    return `  - name: "${n.name}"
    type: vless
    server: ${n.server}
    port: ${n.port}
    uuid: ${n.uuid}
    udp: true
    tls: ${n.tls}
    client-fingerprint: ${n.fp}
    network: ws
    ws-opts:
      path: "${n.path}"
      headers:
        Host: ${n.host}${n.tls ? `    servername: ${n.sni}\n    skip-cert-verify: false` : ''}`;
  }).join('\n')}`;

  return `mixed-port: 7890\nallow-lan: true\nmode: rule\nlog-level: info\nipv6: true\n\n${代理}\n${代理组}\n${rules}`;
}

function 生成SingBoxJSON(链接列表) {
  const 节点列表 = 链接列表.map(解析值链接).filter(n => n && n.proto === 'vless');
  const outbounds = 节点列表.map(n => {
    return {
      type: "vless", tag: n.name, server: n.server, server_port: n.port, uuid: n.uuid,
      tls: n.tls ? { enabled: true, server_name: n.sni, utls: { enabled: true, fingerprint: n.fp } } : undefined,
      transport: { type: "ws", path: n.path, headers: { Host: n.host } }
    };
  });
  return JSON.stringify({ outbounds: [{ type: "selector", tag: "proxy", outbounds: outbounds.map(o => o.tag) }, ...outbounds] }, null, 2);
}

function 解析值链接(链接) {
  try {
    const url = new URL(链接);
    const params = new URLSearchParams(url.search);
    return {
      proto: 'vless', name: decodeURIComponent(url.hash.substring(1)), uuid: url.username, server: url.hostname,
      port: parseInt(url.port) || 443, tls: params.get('security') === 'tls', path: params.get('path'),
      host: params.get('host'), sni: params.get('sni'), fp: params.get('fp') || 'chrome'
    };
  } catch (e) { return null; }
}

async function 处理网页套接字请求(请求) {
  const 网页套接字值 = new WebSocketPair();
  const [客户端值, 服务端值] = Object.values(网页套接字值);
  服务端值.accept();
  let 远程连接 = { socket: null };
  const 流 = new ReadableStream({
    start(控制器) {
      服务端值.addEventListener('message', 事件 => 控制器.enqueue(new Uint8Array(事件.data)));
      服务端值.addEventListener('close', () => 控制器.close());
      服务端值.addEventListener('error', 错 => 控制器.error(错));
    }
  });

  流.pipeTo(new WritableStream({
    async write(块) {
      if (远程连接.socket) {
        const 写入器 = 远程连接.socket.writable.getWriter();
        await 写入器.write(块);
        写入器.releaseLock();
        return;
      }
      if (块.byteLength >= 24) {
        const 端口 = 块[19 + 块[17]] << 8 | 块[20 + 块[17]];
        const 地址类型 = 块[21 + 块[17]];
        let 主机名 = ''; let 索引 = 23 + 块[17];
        if (地址类型 === 1) { 主机名 = 块.slice(索引, 索引+4).join('.'); 索引 += 4; }
        else if (地址类型 === 2) { const len = 块[索引-1]; 主机名 = new TextDecoder().decode(块.slice(索引, 索引+len)); 索引 += len; }
        else if (地址类型 === 3) { 
          const v6 = []; const view = new DataView(块.buffer, 块.byteOffset + 索引, 16);
          for(let i=0; i<8; i++) v6.push(view.getUint16(i*2).toString(16));
          主机名 = v6.join(':'); 索引 += 16;
        }
        await 建立TCP(主机名, 端口, 块.slice(索引), 服务端值, new Uint8Array([块[0], 0]), 远程连接);
      }
    }
  })).catch(() => { try { 服务端值.close(); } catch(e){} });
  return new Response(null, { status: 101, webSocket: 客户端值 });
}

async function 建立TCP(主机, 端口, 数据块, 网页端, 响应头, 远程连接) {
  try {
    const 主套接字 = 连接({ hostname: 主机, port: 端口 });
    const 写入器 = 主套接字.writable.getWriter();
    await 写入器.write(数据块);
    写入器.releaseLock();
    远程连接.socket = 主套接字;
    let 头 = 响应头;
    主套接字.readable.pipeTo(new WritableStream({
      async write(返回数据) {
        if (网页端.readyState === 1) {
          if (头) { 网页端.send(await new Blob([头, 返回数据]).arrayBuffer()); 头 = null; }
          else { 网页端.send(返回数据); }
        }
      }
    })).catch(() => {});
  } catch (错) {}
}