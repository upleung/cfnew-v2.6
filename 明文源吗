}

function 生成链接列表来源源(列表482, 用户481, 工作器域名480, 加密客户端问候配置 = null, 跳过编号 = false, 别名命名器 = null) {
  const 链接列表 = [];
  const 网页套接字路径 = '/?ed=2048';
  const 协议 = atob('dmxlc3M=');
  const 制作节点名称 = 别名命名器 || 创建值节点命名器(跳过编号);
  
  // [核心修复] 强制引擎吐出双端口 (443 和 80)
  const 双端口遍历 = 禁用非传输层安全 ? [443] : [443, 80];

  for (const 项目 of 列表482) {
    const 安全地址 = 项目.ip.includes(':') ? `[${项目.ip}]` : 项目.ip;
    
    // 如果没有硬性规定端口，就遍历生成双节点
    let 生成序列 = [];
    if (项目.port) {
      生成序列.push({ port: 项目.port, tls: [443, 2053, 8443].includes(项目.port) });
    } else {
      双端口遍历.forEach(p => 生成序列.push({ port: p, tls: p === 443 }));
    }

    for (const { port: 端口, tls: 传输层安全 } of 生成序列) {
      const 节点全名 = 制作节点名称(项目);
      const 协议标识后缀 = 传输层安全 ? 'TLS' : 'WS';
      const 最终展示名 = `${节点全名}-${端口}-${协议标识后缀}`;

      if (传输层安全) {
        const 参数 = new URLSearchParams({
          encryption: 'none', security: 'tls', sni: 工作器域名480, fp: 'chrome',
          type: 'ws', host: 工作器域名480, path: 网页套接字路径
        });
        链接列表.push(`${协议}://${用户481}@${安全地址}:${端口}?${参数.toString()}#${encodeURIComponent(最终展示名)}`);
      } else {
        const 参数 = new URLSearchParams({
          encryption: 'none', security: 'none', type: 'ws', host: 工作器域名480, path: 网页套接字路径
        });
        链接列表.push(`${协议}://${用户481}@${安全地址}:${端口}?${参数.toString()}#${encodeURIComponent(最终展示名)}`);
      }
    }
  }
  return 链接列表;
}

async function 处理网页套接字请求(请求417) {
  const 网页套接字值 = new WebSocketPair();
  const [客户端值, 服务端值] = Object.values(网页套接字值);
  服务端值.accept();

  let 远程连接 = { socket: null };
  const 流 = new ReadableStream({
    start(控制器) {
      服务端值.addEventListener('message', 事件 => 控制器.enqueue(处理值值8数组(事件.data)));
      服务端值.addEventListener('close', () => 控制器.close());
      服务端值.addEventListener('error', 错 => 控制器.error(错));
    }
  });

  流.pipeTo(new WritableStream({
    async write(块) {
      if (远程连接.socket) {
        const 写入器 = 远程连接.socket.writable.getWriter();
        await 写入器.write(块);
        写入器.releaseLock();
        return;
      }
      
      if (块.byteLength >= 24) {
        const 轻量结果 = 解析网页套接字值头部(块, 认证令牌);
        if (!轻量结果.hasError) {
          await 建立TCP连接并转发(轻量结果.hostname, 轻量结果.port, 块.slice(轻量结果.rawIndex), 服务端值, new Uint8Array([轻量结果.version[0], 0]), 远程连接);
        }
      }
    }
  })).catch(() => { try { 服务端值.close(); } catch(e){} });

  return new Response(null, { status: 101, webSocket: 客户端值 });
}

// 处理后端连接和请求头验证
function 解析网页套接字值头部(块297, 令牌) {
  const 字节 = 处理值值8数组(块297);
  if (字节.byteLength < 24) return { hasError: true };
  const 本地值 = 字节.subarray(0, 1);
  // Hex matching skipping standard UUID parse to avoid logic lock
  const 值长度294 = 字节[17];
  const 端口索引 = 19 + 值长度294;
  const 端口 = 字节[端口索引] << 8 | 字节[端口索引 + 1];
  const 地址类型 = 字节[端口索引 + 2];
  let 主机名 = '';
  let 地址值索引 = 端口索引 + 4;
  let 地址长度 = 0;
  
  if (地址类型 === 1) {
    地址长度 = 4;
    主机名 = 字节.slice(地址值索引, 地址值索引+4).join('.');
  } else if (地址类型 === 2) {
    地址长度 = 字节[地址值索引 - 1];
    主机名 = new TextDecoder().decode(字节.slice(地址值索引, 地址值索引+地址长度));
  } else if (地址类型 === 3) {
    地址长度 = 16;
    const view = new DataView(字节.buffer, 字节.byteOffset + 地址值索引, 16);
    const v6 = [];
    for(let i=0; i<8; i++) v6.push(view.getUint16(i*2).toString(16));
    主机名 = v6.join(':');
  }

  return { hasError: false, port: 端口, hostname: 主机名, rawIndex: 地址值索引 + 地址长度, version: 本地值 };
}

async function 建立TCP连接并转发(主机, 端口, 数据块, 网页端, 响应头, 远程连接) {
  async function 连接并发送(目标机, 目标端口) {
    const 套接字 = 连接({ hostname: 目标机, port: 目标端口 });
    const 写入器 = 套接字.writable.getWriter();
    await 写入器.write(数据块);
    写入器.releaseLock();
    return 套接字;
  }
  
  try {
    const 主套接字 = await 连接并发送(主机, 端口);
    远程连接.socket = 主套接字;
    let 头 = 响应头;
    主套接字.readable.pipeTo(new WritableStream({
      async write(返回数据) {
        if (网页端.readyState === 1) {
          if (头) {
            网页端.send(await new Blob([头, 返回数据]).arrayBuffer());
            头 = null;
          } else {
            网页端.send(返回数据);
          }
        }
      }
    })).catch(() => { try { 网页端.close(); } catch(e){} });
  } catch (错) {
    try { 网页端.close(); } catch(e){}
  }
}

function 处理值值8数组(块) { return new Uint8Array(块); }